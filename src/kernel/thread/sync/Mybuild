package embox.kernel.thread

module sync {
	depends mutex
	depends sem
	depends barrier
	depends cond
	depends rwlock
	//depends mqueue
}

module mutex {
	@Cflags("-O2") /* thread switch and wakeup path, even in a -O0 kernel */
	source "mutex.c"

	depends embox.kernel.sched.priority.priority
	depends embox.kernel.sched.wait_queue

	depends embox.kernel.sched.mutex
	depends embox.kernel.sched.sched
}

module sem {
	@Cflags("-O2") /* thread switch and wakeup path, even in a -O0 kernel */
	source "semaphore.c"

	depends embox.kernel.sched.sched
}

module barrier {
	source "barrier.c"

	depends embox.kernel.sched.sched
}

module cond {
	@Cflags("-O2") /* thread switch and wakeup path, even in a -O0 kernel */
	source "cond.c"

	depends mutex

	depends embox.kernel.sched.sched
}

module rwlock {
	source "rwlock.c"

	depends embox.kernel.sched.sched
}

module mqueue {
	source "mqueue.c"

	depends embox.kernel.sched.sched
}
