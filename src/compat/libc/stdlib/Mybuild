package embox.compat.libc.stdlib

static module rand {
	source "rand.c"
	source "random.c"
	source "random_r.c"
}

static module config {
	source "getpagesize.c"
	source "sysconf.c"

	depends embox.mem.page_api
}

static module core {
	source "bsearch.c"
	source "qsort.c"
	source "abort.c"
	source "atol.c"
	source "itoa.c"

	depends config
	depends strtox
	@NoRuntime depends rand /* qsort required*/
}

/* strtod, strtol and the rest of the family: an interface, so that an image
 * can take them from another libc (board/common/musl in xenolith-os). */
@DefaultImpl(strtox_embox)
abstract module strtox {
}

static module strtox_embox extends strtox {
	source "strtod.c"
	source "strtof.c"
	source "strtol.c"
	source "strtoul.c"
	source "strtoll.c"
	source "strtoull.c"
}

static module system {
	source "system.c"
	depends embox.cmd.sh.shell_registry
	depends embox.lib.Tokenizer
}

@DefaultImpl(multibyte_embox)
abstract module multibyte {
}

static module multibyte_embox extends multibyte {
	source "wcstombs.c"
	source "mbstowcs.c"
	source "mblen.c"
	source "mbtowc.c"
	source "wctomb.c"
	source "mb_cur_max.c"
}

static module mktemp {
	option string log_level="LOG_DEBUG"

	source "mkstemp.c"
}

static module gcvt {
	source "gcvt.c"
}

static module all {
	depends core,
		config,
		rand,
		system,
		multibyte,
		mktemp,
		gcvt
}
