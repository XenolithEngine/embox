package embox.compat.libc

@DefaultImpl(wchar_extended_none)
abstract module wchar_extended {
}

/* The wide-character functions. An interface, so that an image can take them
 * from another libc (board/common/musl in xenolith-os). */
@DefaultImpl(wchar_embox)
abstract module wchar {
}

static module wchar_embox extends wchar {
	source "wcscmp.c"
	source "wcsncpy.c"
	source "wcstoimax.c"
	source "wcstoumax.c"
	source "wctype.c"
	source "wcslen.c"
	source "wcsnlen.c"
	source "wmemset.c"
	source "wmemmove.c"
	source "wmemcpy.c"
	source "wmemcmp.c"
	source "wmemchr.c"
	source "wcsncasecmp.c"
	source "swprintf.c"
	source "vswprintf.c"
	source "wprintf_impl.c"
	source "wcstol.c"
	source "wcstoll.c"
	source "wcstoul.c"
	source "wcstoull.c"
	source "putwc.c"

	depends wchar_extended
}

module wchar_extended_none extends wchar_extended {
	source "wchar_extended_none.h"
}

static module wchar_extended_stub extends wchar_extended {
	source "wchar_extended_stubs.h"
	source "wchar_stubs.c"
}
