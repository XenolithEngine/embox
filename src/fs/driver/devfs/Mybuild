package embox.fs.driver

@DefaultImpl(devfs_stub)
abstract module devfs {
}

module devfs_old extends devfs {
	source "devfs_oldfs.c"
	source "devfs_common.c"
	source "devfs_drv.c"

	depends embox.device.char_dev
}

module devfs_dvfs extends devfs {
	source "devfs_dvfs.c"
	source "devfs_common.c"
	source "devfs_drv.c"

	/* Not the stub: under DVFS a name that was looked up once stays in the
	 * tree, so a device module that is freed has to take its dentry with
	 * it. See devfs_notify_dvfs.c for what the stub cost. */
	source "devfs_notify_dvfs.c"

	depends embox.device.char_dev
}

module devfs_stub extends devfs {
	source "devfs_notify_stub.c"
}
